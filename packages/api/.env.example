# 本地开发默认值；生产环境必须替换密钥和地址。
DATABASE_URL="file:./dev.db"
PORT=3001

# 生成方式：openssl rand -hex 32。生产未设置时 API 会拒绝启动。
JWT_SECRET="replace-with-a-random-secret"

# 前端地址：登录后回跳，以及 CORS 允许的来源。
WEB_APP_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000"

# API 对外地址：用于拼接 GitHub OAuth 回调。
API_PUBLIC_URL="http://localhost:3001"

# GitHub OAuth App：https://github.com/settings/developers
# 本地回调地址填 http://localhost:3001/api/auth/github/callback
# 留空时 GitHub 登录会提示“暂未配置”，邮箱登录仍可用。
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# 可选；默认是 API_PUBLIC_URL + /api/auth/github/callback。
# GITHUB_CALLBACK_URL="https://feelcurve.com/api/auth/github/callback"
