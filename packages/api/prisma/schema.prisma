generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 登录用户。邮箱 + 密码注册，或 GitHub OAuth 登录；两者可绑定到同一账号。
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String? // GitHub 注册的用户没有密码
  name      String?
  avatarUrl String?
  githubId  String?  @unique
  createdAt DateTime @default(now())
  effects   Effect[]
}

model Effect {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
}
